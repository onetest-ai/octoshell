        "dependsOn": [
          "reverify-2",
        ],
        "id": "reverify-3",
        "label": "re-verify",
        "repeat": true,
      },
    ],
    "title": "Reverify",
  },
  {
    "steps": [
      {
        "agent": "run-reporter",
        "id": "close-1",
        "label": "write the run report",
      },
      {
        "agent": "project-manager",
        "dependsOn": [
          "close-1",
        ],
        "id": "close-2",
        "label": "close the bugs",
      },
    ],
    "title": "Close",
  },
]
`;

